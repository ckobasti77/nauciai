# LiteSpeed / Apache: služi video i moderne slike sa ispravnim MIME tipom i bez
# kompresije. Bez ovoga LiteSpeed .webm služi kao text/plain + Content-Encoding: br,
# pa ga Safari/iOS/Firefox odbiju i landing ostaje na posteru. Ovaj fajl mora da
# stigne u doc root hostinga; na Vercel/Next je bezopasan dotfile (ne služi se).
AddType video/webm .webm
AddType video/mp4 .mp4
AddType image/webp .webp
AddType image/avif .avif

<FilesMatch "\.(webm|mp4)$">
  SetEnv no-gzip 1
  SetEnv no-brotli 1
  <IfModule mod_headers.c>
    Header unset Content-Encoding
  </IfModule>
</FilesMatch>

# Kada je jezički kolačić postavljen, "/" ima dve varijante (sr / 307 na /en) — LiteSpeed
# keš ne sme da servira jednu drugoj. Zahtevi BEZ kolačića se i dalje kesiraju normalno i
# uvek dobijaju srpsku verziju (upravo ono što Googlebot treba da vidi).
<IfModule LiteSpeed>
  RewriteEngine On
  RewriteCond %{HTTP_COOKIE} nauciai_locale=
  RewriteRule .* - [E=Cache-Control:no-cache]
</IfModule>

# `Vary: Cookie` na "/" i na rubu (Next App Router pregazi Vary na renderovanom RSC odgovoru,
# pa ga ovde dodajemo za "/"): deljeni keš vari po jezičkom kolačiću. Samo za tačan koren.
<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/$" NAUCIAI_ROOT=1
  Header append Vary "Cookie" env=NAUCIAI_ROOT
</IfModule>
